# Copie para .env na raiz. Este arquivo é lido apenas pelo servidor.
APP_ENV=development
STORAGE_BACKEND=mongodb
# Docker Compose inicia um replica set local; produção usa a URI do Cosmos DB.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=entrelinhas
MONGODB_COLLECTION=livraria
# Use uma chave estável também localmente para manter a sessão após reiniciar.
# Em produção, gere uma chave aleatória estável com pelo menos 32 caracteres.
SECRET_KEY=
# Origens exatas do CLIENTE, sem barra final. Separe por vírgula.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
PORT=5000
